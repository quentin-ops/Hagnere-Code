{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hagnere-code",
  "main": ".open-next/worker.js",
  "compatibility_date": "2026-07-19",
  "compatibility_flags": ["nodejs_compat"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "analytics_engine_datasets": [
    {
      "binding": "FUNNEL_ANALYTICS",
      "dataset": "hagnere_code_funnel"
    }
  ],
  "vars": {
    // Valeur runtime alignée avec la production. Les scripts build/cf:build
    // imposent aussi cette valeur pendant le rendu statique des métadonnées.
    "NEXT_PUBLIC_ENV": "production",
    // Le Worker reçoit cet en-tête de l'infrastructure Cloudflare. Sans cette
    // attestation explicite, le limiteur regrouperait les visiteurs sous
    // `unknown` afin de ne jamais faire confiance à un header client.
    "TRUST_CF_CONNECTING_IP": "1"
  }
}
